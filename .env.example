# MealPass Environment Variables - Cosmopolitan University (NextGen Technologies)

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
# Service Role Key (SERVER ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
STRICT_SUPABASE_MODE="true"

# Direct Database Connection (Supabase PostgreSQL / Pooler)
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mealpass_db?schema=public"

# Application Branding & Metadata
NEXT_PUBLIC_APP_NAME="MealPass"
NEXT_PUBLIC_APP_DESCRIPTOR="Digital Feeding & Cafeteria Platform"
NEXT_PUBLIC_TECH_ATTRIBUTION="Powered by NextGen Technologies"
NEXT_PUBLIC_UNIVERSITY_NAME="Cosmopolitan University"
NEXT_PUBLIC_UNIVERSITY_SLUG="cosmopolitan"
NEXT_PUBLIC_DEFAULT_CURRENCY="NGN"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
