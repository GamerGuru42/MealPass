generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MULTI-TENANT: University (Tenant)
// ============================================
model University {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  logoUrl        String?  @map("logo_url")
  primaryColor   String?  @default("#1e3a5f") @map("primary_color")
  secondaryColor String?  @default("#f59e0b") @map("secondary_color")
  address        String?
  contactEmail   String?  @map("contact_email")
  contactPhone   String?  @map("contact_phone")
  currency       String   @default("NGN")
  timezone       String   @default("Africa/Lagos")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  users            User[]
  userRoles        UserRole[]
  studentProfiles  StudentProfile[]
  feedingAccounts  FeedingAccount[]
  ledgerEntries    LedgerEntry[]
  cafeterias       Cafeteria[]
  cafeteriaStaff   CafeteriaStaff[]
  menuCategories   MenuCategory[]
  menuItems        MenuItem[]
  orders           Order[]
  auditLogs        AuditLog[]
  feedingPeriods   FeedingPeriod[]

  @@map("universities")
}

// ============================================
// USER & AUTHENTICATION
// ============================================
model User {
  id              String   @id @default(uuid())
  universityId    String   @map("university_id")
  email           String
  passwordHash    String   @map("password_hash")
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  phone           String?
  avatarUrl       String?  @map("avatar_url")
  isActive        Boolean  @default(true) @map("is_active")
  isEmailVerified Boolean  @default(false) @map("is_email_verified")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  university       University       @relation(fields: [universityId], references: [id])
  userRoles        UserRole[]       @relation("UserRoles")
  assignedRoles    UserRole[]       @relation("RoleAssigner")
  studentProfile   StudentProfile?
  cafeteriaStaff   CafeteriaStaff[]
  ledgerEntriesCreated LedgerEntry[] @relation("LedgerCreator")
  ordersReceived   Order[]          @relation("OrderReceiver")
  priceChanges     MenuItemPriceHistory[]
  orderStatusChanges OrderStatusHistory[]
  auditLogs        AuditLog[]
  staffAssignments CafeteriaStaff[] @relation("StaffAssigner")

  @@unique([universityId, email])
  @@index([universityId])
  @@index([email])
  @@map("users")
}

model Role {
  id          String     @id @default(uuid())
  name        RoleName   @unique
  description String?

  userRoles UserRole[]

  @@map("roles")
}

enum RoleName {
  STUDENT
  CAFETERIA_STAFF
  CAFETERIA_HEAD
  FINANCE_ADMIN
  SUPER_ADMIN
}

model UserRole {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  roleId       String   @map("role_id")
  universityId String   @map("university_id")
  assignedBy   String?  @map("assigned_by")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  user       User       @relation("UserRoles", fields: [userId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id])
  university University @relation(fields: [universityId], references: [id])
  assigner   User?      @relation("RoleAssigner", fields: [assignedBy], references: [id])

  @@unique([userId, roleId, universityId])
  @@index([universityId])
  @@map("user_roles")
}

// ============================================
// STUDENT
// ============================================
model StudentProfile {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  universityId      String    @map("university_id")
  matricNumber      String    @map("matric_number")
  department        String?
  faculty           String?
  level             String?
  enrollmentYear    Int?      @map("enrollment_year")
  graduationYear    Int?      @map("graduation_year")
  transactionPinHash String?  @map("transaction_pin_hash")
  pinAttempts       Int       @default(0) @map("pin_attempts")
  pinLockedUntil    DateTime? @map("pin_locked_until")
  isFeedingActive   Boolean   @default(false) @map("is_feeding_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  user           User           @relation(fields: [userId], references: [id])
  university     University     @relation(fields: [universityId], references: [id])
  feedingAccount FeedingAccount?
  orders         Order[]

  @@unique([universityId, matricNumber])
  @@index([universityId])
  @@map("student_profiles")
}

// ============================================
// FEEDING ACCOUNT & LEDGER
// ============================================
model FeedingAccount {
  id               String   @id @default(uuid())
  studentProfileId String   @unique @map("student_profile_id")
  universityId     String   @map("university_id")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id])
  university     University     @relation(fields: [universityId], references: [id])
  ledgerEntries  LedgerEntry[]

  @@index([universityId])
  @@map("feeding_accounts")
}

model LedgerEntry {
  id               String          @id @default(uuid())
  feedingAccountId String          @map("feeding_account_id")
  universityId     String          @map("university_id")
  transactionType  TransactionType @map("transaction_type")
  amount           Decimal         @db.Decimal(12, 2)
  runningBalance   Decimal         @map("running_balance") @db.Decimal(12, 2)
  referenceId      String?         @map("reference_id") // Order ID for meal deductions
  description      String
  createdBy        String          @map("created_by")
  createdAt        DateTime        @default(now()) @map("created_at")
  metadata         Json?           // Audit details, correction references, etc.
  feedingPeriodId  String?         @map("feeding_period_id")

  // Relations
  feedingAccount FeedingAccount @relation(fields: [feedingAccountId], references: [id])
  university     University     @relation(fields: [universityId], references: [id])
  creator        User           @relation("LedgerCreator", fields: [createdBy], references: [id])

  // APPEND-ONLY: No updates, no deletes enforced at application level
  @@index([feedingAccountId, createdAt])
  @@index([universityId])
  @@index([transactionType])
  @@index([referenceId])
  @@map("ledger_entries")
}

enum TransactionType {
  ALLOCATION
  MEAL_DEDUCTION
  REFUND
  REVERSAL
  ADJUSTMENT
}

// ============================================
// CAFETERIA
// ============================================
model Cafeteria {
  id             String   @id @default(uuid())
  universityId   String   @map("university_id")
  name           String
  location       String?
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  operatingHours Json?    @map("operating_hours")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  university     University       @relation(fields: [universityId], references: [id])
  staff          CafeteriaStaff[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  orders         Order[]

  @@index([universityId])
  @@map("cafeterias")
}

model CafeteriaStaff {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  cafeteriaId     String   @map("cafeteria_id")
  universityId    String   @map("university_id")
  roleInCafeteria CafeteriaRole @default(STAFF) @map("role_in_cafeteria")
  assignedAt      DateTime @default(now()) @map("assigned_at")
  assignedBy      String?  @map("assigned_by")

  user       User       @relation(fields: [userId], references: [id])
  cafeteria  Cafeteria  @relation(fields: [cafeteriaId], references: [id])
  university University @relation(fields: [universityId], references: [id])
  assigner   User?      @relation("StaffAssigner", fields: [assignedBy], references: [id])

  @@unique([userId, cafeteriaId])
  @@index([universityId])
  @@map("cafeteria_staff")
}

enum CafeteriaRole {
  STAFF
  HEAD
}

// ============================================
// MENU
// ============================================
model MenuCategory {
  id           String   @id @default(uuid())
  universityId String   @map("university_id")
  cafeteriaId  String   @map("cafeteria_id")
  name         String
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  university University @relation(fields: [universityId], references: [id])
  cafeteria  Cafeteria  @relation(fields: [cafeteriaId], references: [id])
  menuItems  MenuItem[]

  @@index([universityId, cafeteriaId])
  @@map("menu_categories")
}

model MenuItem {
  id           String   @id @default(uuid())
  universityId String   @map("university_id")
  cafeteriaId  String   @map("cafeteria_id")
  categoryId   String   @map("category_id")
  name         String
  description  String?
  imageUrl     String?  @map("image_url") // OPTIONAL - not required
  currentPrice Decimal  @map("current_price") @db.Decimal(12, 2)
  isAvailable  Boolean  @default(true) @map("is_available")
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  university   University             @relation(fields: [universityId], references: [id])
  cafeteria    Cafeteria              @relation(fields: [cafeteriaId], references: [id])
  category     MenuCategory           @relation(fields: [categoryId], references: [id])
  priceHistory MenuItemPriceHistory[]
  orderItems   OrderItem[]

  @@index([universityId, cafeteriaId])
  @@index([categoryId])
  @@map("menu_items")
}

model MenuItemPriceHistory {
  id         String   @id @default(uuid())
  menuItemId String   @map("menu_item_id")
  oldPrice   Decimal  @map("old_price") @db.Decimal(12, 2)
  newPrice   Decimal  @map("new_price") @db.Decimal(12, 2)
  changedBy  String   @map("changed_by")
  changedAt  DateTime @default(now()) @map("changed_at")
  reason     String?

  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
  changer  User     @relation(fields: [changedBy], references: [id])

  @@index([menuItemId])
  @@map("menu_item_price_history")
}

// ============================================
// ORDERS
// ============================================
model Order {
  id               String      @id @default(uuid())
  orderNumber      String      @map("order_number")
  universityId     String      @map("university_id")
  studentProfileId String      @map("student_profile_id")
  cafeteriaId      String      @map("cafeteria_id")
  status           OrderStatus @default(PLACED)
  totalAmount      Decimal     @map("total_amount") @db.Decimal(12, 2)
  pickupCode       String?     @map("pickup_code")
  pickupQrToken    String?     @map("pickup_qr_token")
  notes            String?
  placedAt         DateTime    @default(now()) @map("placed_at")
  acceptedAt       DateTime?   @map("accepted_at")
  preparingAt      DateTime?   @map("preparing_at")
  readyAt          DateTime?   @map("ready_at")
  receivedAt       DateTime?   @map("received_at")
  receivedBy       String?     @map("received_by")
  cancelledAt      DateTime?   @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  university     University         @relation(fields: [universityId], references: [id])
  studentProfile StudentProfile     @relation(fields: [studentProfileId], references: [id])
  cafeteria      Cafeteria          @relation(fields: [cafeteriaId], references: [id])
  receiver       User?              @relation("OrderReceiver", fields: [receivedBy], references: [id])
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]

  @@unique([universityId, orderNumber])
  @@index([universityId, studentProfileId])
  @@index([universityId, cafeteriaId, status])
  @@index([pickupQrToken])
  @@index([pickupCode, universityId])
  @@map("orders")
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  RECEIVED
  CANCELLED
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String  @map("order_id")
  menuItemId String  @map("menu_item_id")
  itemName   String  @map("item_name")   // Captured at order time
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2) // Captured at order time!
  quantity   Int
  subtotal   Decimal @db.Decimal(12, 2)  // unitPrice * quantity
  createdAt  DateTime @default(now()) @map("created_at")

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id             String       @id @default(uuid())
  orderId        String       @map("order_id")
  previousStatus OrderStatus? @map("previous_status")
  newStatus      OrderStatus  @map("new_status")
  changedBy      String       @map("changed_by")
  reason         String?
  isManual       Boolean      @default(false) @map("is_manual")
  createdAt      DateTime     @default(now()) @map("created_at")

  order   Order @relation(fields: [orderId], references: [id])
  changer User  @relation(fields: [changedBy], references: [id])

  @@index([orderId])
  @@map("order_status_history")
}

// ============================================
// FEEDING PERIOD
// ============================================
model FeedingPeriod {
  id           String   @id @default(uuid())
  universityId String   @map("university_id")
  name         String   // e.g., "2026/2027 First Semester"
  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  university University @relation(fields: [universityId], references: [id])

  @@index([universityId])
  @@map("feeding_periods")
}

// ============================================
// AUDIT LOG
// ============================================
model AuditLog {
  id           String   @id @default(uuid())
  universityId String   @map("university_id")
  userId       String   @map("user_id")
  action       String
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  oldValues    Json?    @map("old_values")
  newValues    Json?    @map("new_values")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  university University @relation(fields: [universityId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@index([universityId, entityType, entityId])
  @@index([universityId, userId])
  @@index([createdAt])
  @@map("audit_logs")
}
